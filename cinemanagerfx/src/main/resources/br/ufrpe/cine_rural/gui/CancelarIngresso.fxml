<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="700.0" prefWidth="900.0"
            style="-fx-background-color: BLACK;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.CancelarIngressoController">

   <center>
      <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
         <padding><Insets bottom="40.0" left="60.0" right="60.0" top="40.0" /></padding>

         <!-- Título -->
         <Text fill="WHITE" textAlignment="CENTER">
            <font><Font name="System Bold" size="28.0" /></font>
            <text>CANCELAR</text>
         </Text>
         <Text fill="#b90000" textAlignment="CENTER">
            <font><Font name="System Bold" size="28.0" /></font>
            <text>INGRESSO</text>
         </Text>

         <!-- Instruções -->
         <Label fx:id="lblInstrucao" text="Informe os dados do seu ingresso para cancelar a compra."
                textFill="WHITE" wrapText="true" prefWidth="600.0" textAlignment="CENTER">
            <font><Font name="System Bold" size="14.0" /></font>
         </Label>

         <!-- Campos -->
         <VBox spacing="16.0" alignment="CENTER_LEFT" maxWidth="500.0">

            <Label text="Nome do Cliente:" textFill="WHITE">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <TextField fx:id="txtNomeCliente" promptText="Ex: João Silva"
                       prefWidth="500.0"
                       style="-fx-background-color: #1a1a1a; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-border-color: #b90000; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>

            <Label text="Código do Assento:" textFill="WHITE">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <TextField fx:id="txtCodigoAssento" promptText="Ex: A1"
                       prefWidth="500.0"
                       style="-fx-background-color: #1a1a1a; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-border-color: #b90000; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>

            <Label text="Horário da Sessão (AAAA-MM-DDTHH:MM):" textFill="WHITE">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <TextField fx:id="txtHorarioSessao" promptText="Ex: 2025-12-25T20:00"
                       prefWidth="500.0"
                       style="-fx-background-color: #1a1a1a; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-border-color: #b90000; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>
         </VBox>

         <!-- Mensagem de feedback -->
         <Label fx:id="lblMensagem" text="" textFill="#b90000" wrapText="true"
                prefWidth="600.0" textAlignment="CENTER">
            <font><Font name="System Bold" size="13.0" /></font>
         </Label>

         <!-- Botões -->
         <HBox spacing="40.0" alignment="CENTER">
            <Button fx:id="btnVoltar" text="Voltar" mnemonicParsing="false"
                    onAction="#btnVoltarAction"
                    prefWidth="160.0" prefHeight="40.0"
                    style="-fx-background-color: #333333; -fx-background-radius: 15; -fx-border-color: WHITE; -fx-border-radius: 15; -fx-text-fill: WHITE; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Button fx:id="btnCancelarIngresso" text="Confirmar Cancelamento" mnemonicParsing="false"
                    onAction="#btnCancelarIngressoAction"
                    prefWidth="220.0" prefHeight="40.0"
                    style="-fx-background-color: #b90000; -fx-background-radius: 15; -fx-border-color: WHITE; -fx-border-radius: 15; -fx-text-fill: WHITE; -fx-font-size: 13px; -fx-font-weight: bold;"/>
         </HBox>
      </VBox>
   </center>
</BorderPane>
