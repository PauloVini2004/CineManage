<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.FilmesController"
    prefWidth="900.0"
    prefHeight="700.0"
    style="-fx-background-color: black;">

    <top>
        <HBox style="-fx-background-color: black; -fx-padding: 10 20 10 20;">
            <Button
                fx:id="btnVoltar"
                text="Voltar"
                onAction="#voltarParaHome"
                style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 14px; -fx-padding: 6 18 6 18;" />
        </HBox>
    </top>

    <center>
        <ScrollPane
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox fx:id="containerFilmes"
                      spacing="20"
                      prefWidth="900.0"
                      style="-fx-padding: 20;"/>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
