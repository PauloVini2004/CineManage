<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
        prefWidth="900"
        prefHeight="700"
        styleClass="root"
        stylesheets="@EstiloProduto.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.ProdutoController">

    <children>

        <VBox
                alignment="TOP_CENTER"
                prefWidth="900"
                prefHeight="700"
                spacing="20">

            <Label
                    text=" "
                    styleClass="titulo"/>

            <HBox
                    alignment="CENTER"
                    spacing="20">

                <Button
                        fx:id="btnVoltar"
                        text="Voltar"
                        styleClass="btn-voltar"/>

                <Button
                        fx:id="resumoCompra"
                        text="0 itens | Subtotal R$0,00"
                        styleClass="btn-subtotal"/>

                <Button
                        fx:id="btnAvancar"
                        text="Avançar"
                        styleClass="btn-avancar"/>

            </HBox>

            <ScrollPane
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">


                <content>
                    <TilePane
                            fx:id="tileProdutos"
                            alignment="TOP_LEFT"
                            prefColumns="5"
                            hgap="30"
                            vgap="25"/>
                </content>

            </ScrollPane>

        </VBox>

    </children>

</AnchorPane>