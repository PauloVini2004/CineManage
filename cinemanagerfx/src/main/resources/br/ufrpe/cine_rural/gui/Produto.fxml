<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.ProdutoController"
            prefHeight="700.0"
            prefWidth="900.0"
            stylesheets="@EstiloProduto.css"
            styleClass="root">

    <children>

        <!-- TÍTULO -->
        <Label layoutX="55.0"
               layoutY="50.0"
               styleClass="titulo"
               text="SELECIONE O PRODUTO"/>

        <!-- ÁREA SUPERIOR -->
        <Button fx:id="btnVoltar" layoutX="55.0"
                layoutY="145.0"
                styleClass="btn-voltar"
                text="Voltar"/>

        <Button fx:id="resumoCompra"
                layoutX="285.0"
                layoutY="145.0"
                styleClass="btn-subtotal"
                text="0 itens | Subtotal R$0,00"/>

        <Button fx:id="btnAvancar" layoutX="475.0"
                layoutY="145.0"
                styleClass="btn-avancar"
                text="Avançar"/>

        <!-- PRODUTOS -->
        <TilePane hgap="73.0" vgap="30.0" prefColumns="5" layoutX="50.0"
                  layoutY="200.0">

            <!-- Produto 1 -->
            <VBox spacing="4" styleClass="card-produto">
                <Label fx:id="nomeProduto1" styleClass="nome-produto"/>
                <StackPane styleClass="imagem-produto">
                    <ImageView fx:id="imagemProduto1" fitHeight="150" fitWidth="100" preserveRatio="true"/>
                </StackPane>
                <Label fx:id="contadorProduto1" styleClass="contador" text="0 itens"/>
                <HBox spacing="8">
                    <Label fx:id="precoProduto1" styleClass="preco"/>
                    <Button fx:id="maisProduto1" styleClass="btn-mais" text="+"/>
                    <Button fx:id="menosProduto1" styleClass="btn-menos" text="-"/>
                </HBox>
            </VBox>

