<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="900.0" styleClass="root" stylesheets="@EstiloListarProdutos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER">
            <children>

                <Button fx:id="btnVoltar" styleClass="btn-voltar" text="Voltar" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnAdicionar" styleClass="btn-adicionar" text="Adicionar produto" />

            </children>

            <padding>
                <Insets bottom="40" left="70" right="70" top="70" />
            </padding>
        </HBox>
    </top>

    <center>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane">

            <content>

                <TilePane hgap="55" prefColumns="4" styleClass="tile-pane" vgap="70">

                    <!-- Produto -->

                    <VBox spacing="4" styleClass="card-produto">

                        <Label styleClass="nome-produto" text="Pipoca" textFill="WHITE" />

                        <ImageView fx:id="imagemProduto5" fitHeight="150" fitWidth="100" preserveRatio="true"/>

                        <Label styleClass="disponivel" text="10 itens disp." />

                        <HBox alignment="CENTER_LEFT" spacing="8">

                            <Label styleClass="preco" text="R$14,90" />

                            <Button styleClass="btn-editar" text="Editar" />

                        </HBox>

                    </VBox>

                    <!-- Duplicar -->

                </TilePane>

            </content>

        </ScrollPane>

    </center>

</BorderPane>
