<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.ListarProdutosController"
        stylesheets="@EstiloListarProdutos.css"
        styleClass="root"
        prefHeight="700.0"
        prefWidth="900.0">

    <top>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="70" right="70" bottom="40" left="70"/>
            </padding>

            <children>

                <Button
                        fx:id="btnVoltar"
                        text="Voltar"
                        styleClass="btn-voltar"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="btnAdicionar"
                        text="Adicionar produto"
                        styleClass="btn-adicionar"/>

            </children>

        </HBox>
    </top>

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="scroll-pane">

            <content>

                <TilePane
                        fx:id="tileProdutos"
                        prefColumns="4"
                        hgap="55"
                        vgap="70"
                        styleClass="tile-pane"/>

            </content>

        </ScrollPane>

    </center>

</BorderPane>