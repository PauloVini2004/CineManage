<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="720.0"
        prefWidth="1000.0"
        stylesheets="@Tela2.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.RelatorioBomboniereController">


    <top>
        <VBox spacing="8" styleClass="header">
            <padding><Insets top="15" right="20" bottom="12" left="20"/></padding>

            <Label text="Relatório da Bomboniere" styleClass="title"/>
            <Separator/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Data Inicial:"/>
                <DatePicker fx:id="dpInicio" promptText="Data inicial"/>

                <Label text="Data Final:"/>
                <DatePicker fx:id="dpFim" promptText="Data final"/>

                <Button text="Atualizar"
                        styleClass="primary-button"
                        onAction="#onAtualizar"/>
            </HBox>
        </VBox>
    </top>


    <center>
        <VBox spacing="16">
            <padding><Insets top="16" right="20" bottom="10" left="20"/></padding>


            <VBox spacing="6" styleClass="card" VBox.vgrow="ALWAYS">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <Label text="Faturamento por Produto no Período"/>
                <BarChart fx:id="graficoBomboniere"
                          animated="false"
                          prefHeight="250"
                          VBox.vgrow="ALWAYS">
                    <xAxis><CategoryAxis label="Produto"/></xAxis>
                    <yAxis><NumberAxis label="R$"/></yAxis>
                </BarChart>
            </VBox>


            <VBox spacing="6" styleClass="card">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <Label text="Detalhamento por Produto"/>
                <TableView fx:id="tbProdutos" prefHeight="170">
                    <columns>
                        <TableColumn fx:id="colProduto"
                                     text="Produto"
                                     prefWidth="260"/>
                        <TableColumn fx:id="colQuantidade"
                                     text="Quantidade Vendida"
                                     prefWidth="180"/>
                        <TableColumn fx:id="colFaturamento"
                                     text="Valor Arrecadado"
                                     prefWidth="180"/>
                    </columns>
                    <placeholder><Label text="Nenhum dado disponível"/></placeholder>
                </TableView>
            </VBox>


            <VBox spacing="6" styleClass="card">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <Label text="Alertas — Estoque Baixo"/>
                <ListView fx:id="listaAlertasEstoque" prefHeight="95"/>
            </VBox>

        </VBox>
    </center>


    <bottom>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="20" bottom="14" left="20"/></padding>

            <Button text="Voltar"
                    styleClass="secondary-button"
                    onAction="#onVoltar"/>

            <Button text="Exportar CSV"
                    styleClass="primary-button"
                    onAction="#onExportarCSV"/>
        </HBox>
    </bottom>

</BorderPane>
