<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="720.0"
        prefWidth="1000.0"
        stylesheets="@Tela1.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.RelatorioFilmesController">


    <top>
        <VBox spacing="8" styleClass="header">
            <padding><Insets top="15" right="20" bottom="12" left="20"/></padding>

            <Label text="Relatório de Bilheteria por Filme" styleClass="title"/>
            <Separator/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Filme:"/>
                <ComboBox fx:id="cbFilmes"
                          promptText="Todos os filmes"
                          prefWidth="240"/>
                <Button text="Atualizar"
                        styleClass="primary-button"
                        onAction="#onAtualizar"/>
            </HBox>
        </VBox>
    </top>


    <center>
        <VBox spacing="16">
            <padding><Insets top="16" right="20" bottom="10" left="20"/></padding>


            <HBox spacing="16">

                <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Total de Ingressos Vendidos"/>
                    <Label fx:id="lblTotalIngressos" text="0" styleClass="label-metrica-valor"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Taxa de Ocupação"/>
                    <Label fx:id="lblTaxaOcupacao" text="0%" styleClass="label-metrica-valor"/>
                    <ProgressBar fx:id="barraOcupacao"
                                 maxWidth="Infinity"
                                 progress="0"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Faturamento"/>
                    <Label fx:id="lblFaturamento" text="R$ 0,00" styleClass="label-metrica-valor"/>
                </VBox>

            </HBox>


            <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="Assentos Mais Ocupados (Top 10)"/>
                <TableView fx:id="tbAssentos" VBox.vgrow="ALWAYS" prefHeight="280">
                    <columns>
                        <TableColumn fx:id="colCodigo"
                                     text="Assento"
                                     prefWidth="200"/>
                        <TableColumn fx:id="colFrequencia"
                                     text="Frequência de Ocupação"
                                     prefWidth="220"/>
                    </columns>
                    <placeholder><Label text="Nenhum dado disponível"/></placeholder>
                </TableView>
            </VBox>


            <VBox spacing="6" styleClass="card">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <Label text="Filmes com Baixa Procura"/>
                <ListView fx:id="listaAlertasFilmes" prefHeight="100"/>
            </VBox>

        </VBox>
    </center>


    <bottom>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="20" bottom="14" left="20"/></padding>

            <Button text="Voltar"
                    styleClass="secondary-button"
                    onAction="#onVoltar"/>

            <Button text="Exportar CSV"
                    styleClass="primary-button"
                    onAction="#onExportarCSV"/>

            <Button text="Enviar E-mail"
                    styleClass="secondary-button"
                    onAction="#onEnviarEmail"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="Seguir "
                    styleClass="primary-button"
                    onAction="#onProximo"/>
        </HBox>
    </bottom>

</BorderPane>
