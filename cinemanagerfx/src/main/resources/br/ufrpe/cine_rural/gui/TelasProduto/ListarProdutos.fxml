<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>

<BorderPane prefHeight="700.0" prefWidth="900.0" styleClass="root" stylesheets="@EstiloListarProdutos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.ListarProdutosController">

    <top>
        <HBox alignment="CENTER" prefHeight="158.0" prefWidth="900.0">
            <padding>
                <Insets bottom="40" left="70" right="70" top="70" />
            </padding>

            <children>

                <Button fx:id="btnVoltar" styleClass="btn-voltar" text="Voltar" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnAdicionar" styleClass="btn-adicionar" text="Adicionar produto" />

            </children>

        </HBox>
    </top>

    <center>

        <ScrollPane hbarPolicy="NEVER" vbarPolicy="NEVER"
                    prefHeight="600.0" prefWidth="440.0" styleClass="scroll-pane"  fitToWidth="false" style="-fx-translate-x: -20">

            <content>

                <TilePane fx:id="tileProdutos" hgap="60" prefColumns="5" style="-fx-translate-x: 65 " styleClass="tile-pane" vgap="60" />

            </content>

        </ScrollPane>

    </center>

</BorderPane>
