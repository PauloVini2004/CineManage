<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.ProdutoController"
            prefHeight="700.0"
            prefWidth="900.0"
            stylesheets="@EstiloProduto.css"
            styleClass="root">

    <children>

        <Label layoutX="55.0"
               layoutY="50.0"
               styleClass="titulo"
               text="SELECIONE O PRODUTO"/>

        <Button fx:id="btnVoltar"
                layoutX="55.0"
                layoutY="145.0"
                styleClass="btn-voltar"
                text="Voltar"/>

        <Button fx:id="resumoCompra"
                layoutX="285.0"
                layoutY="145.0"
                styleClass="btn-subtotal"
                text="0 itens | Subtotal R$0,00"/>

        <Button fx:id="btnAvancar"
                layoutX="475.0"
                layoutY="145.0"
                styleClass="btn-avancar"
                text="Avançar"/>

        <Button fx:id="btnMais"
                styleClass="btn-mais"
                text="+"/>
        <Button fx:id="btnMenoss"
                styleClass="btn-menos"
                text="-"/>

        <ScrollPane layoutX="50"
                    layoutY="200"
                    prefWidth="900"
                    prefHeight="500"
                    fitToWidth="true"
                    style="-fx-background:black;">

            <content>

                <TilePane fx:id="tileProdutos"
                          styleClass="area-produtos"
                          prefColumns="4"
                          hgap="30"
                          vgap="30"/>

            </content>

        </ScrollPane>

    </children>

</AnchorPane>